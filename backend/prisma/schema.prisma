datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum RoleName {
  ADMINISTRADOR
  SUPERADMINISTRADOR
  LOGISTICA
  VENTAS
}

enum CategoryType {
  EQUIPO_ELECTRONICO
  CONSUMIBLE
}

enum MovementType {
  INGRESO_COMPRA
  SALIDA_VENTA
  AJUSTE
  GARANTIA_REEMPLAZO
}

enum SerialItemStatus {
  EN_STOCK
  RESERVADO
  VENDIDO
  EN_GARANTIA
  RETORNO_CHINA
}

enum EquipmentEventType {
  INGRESO
  VENTA
  MANTENIMIENTO_PREVENTIVO
  MANTENIMIENTO_USO
  FALLA_REPORTADA
  RETORNO_FABRICA_CHINA
}

enum ReservationStatus {
  ACTIVA
  COMPLETADA
  CANCELADA
}

model Role {
  id          Int      @id @default(autoincrement())
  name        RoleName @unique
  description String?
  users       User[]
}

model User {
  id            String              @id @default(uuid())
  roleId        Int
  role          Role                @relation(fields: [roleId], references: [id])
  fullName      String
  email         String              @unique
  passwordHash  String
  isActive      Boolean             @default(true)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  auditLogs     AuditLog[]
  movements     InventoryMovement[]
  equipmentEvents EquipmentEvent[]
  reservations  InventoryReservation[]
}

model AuditLog {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  action        String   
  entityName    String
  entityId      String
  payloadBefore Json?
  payloadAfter  Json?
  ipAddress     String?
  createdAt     DateTime @default(now())
}

model Category {
  id          Int          @id @default(autoincrement())
  name        CategoryType @unique
  description String?
  products    Product[]
}

model Product {
  id             String               @id @default(uuid())
  sku            String               @unique
  name           String
  description    String?
  categoryId     Int
  category       Category             @relation(fields: [categoryId], references: [id])
  requiresSerial Boolean              @default(false)
  unitOfMeasure  String               
  minStockAlert  Int                  @default(5)
  baseCost       Decimal              @db.Decimal(12, 2)
  salePrice      Decimal              @db.Decimal(12, 2)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  serializedItems SerializedItem[]
  movements      InventoryMovement[]
  reservations   InventoryReservation[]
}

model SerializedItem {
  id                String           @id @default(uuid())
  productId         String
  product           Product          @relation(fields: [productId], references: [id])
  serialNumber      String           @unique
  status            SerialItemStatus @default(EN_STOCK)
  currentCustomerId String?
  currentCustomer   Customer?        @relation(fields: [currentCustomerId], references: [id])
  entryDate         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  historyEvents     EquipmentEvent[]
}

model EquipmentEvent {
  id               String             @id @default(uuid())
  serializedItemId String
  serializedItem   SerializedItem     @relation(fields: [serializedItemId], references: [id])
  eventType        EquipmentEventType
  description      String
  customerId       String?
  customer         Customer?          @relation(fields: [customerId], references: [id])
  registeredByUserId String
  registeredByUser User               @relation(fields: [registeredByUserId], references: [id])
  eventDate        DateTime           @default(now())
}

model Customer {
  id            String               @id @default(uuid())
  documentId    String               @unique
  companyOrName String
  phone         String?
  email         String?
  address       String?
  createdAt     DateTime             @default(now())
  serializedItems SerializedItem[]
  equipmentEvents EquipmentEvent[]
  movements     InventoryMovement[]
  reservations  InventoryReservation[]
}

model InventoryMovement {
  id                 String       @id @default(uuid())
  productId          String
  product            Product      @relation(fields: [productId], references: [id])
  movementType       MovementType
  quantity           Int
  invoiceNumber      String?      
  customerId         String?
  customer           Customer?    @relation(fields: [customerId], references: [id])
  registeredByUserId String
  registeredByUser   User         @relation(fields: [registeredByUserId], references: [id])
  notes              String?
  movementDate       DateTime     @default(now())
}

model InventoryReservation {
  id                String            @id @default(uuid())
  productId         String
  product           Product           @relation(fields: [productId], references: [id])
  customerId        String
  customer          Customer          @relation(fields: [customerId], references: [id])
  reservedQuantity  Int
  serializedItemIds Json?             
  status            ReservationStatus @default(ACTIVA)
  reason            String?
  createdByUserId   String
  createdBy         User              @relation(fields: [createdByUserId], references: [id])
  reservationDate   DateTime          @default(now())
  expiryDate        DateTime?
}
